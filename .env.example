# ==============================================================================
# ENTERPRISE COVID-19 ANALYTICS PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in all values before running the application.
# Never commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------------------------
APP_NAME="Enterprise COVID-19 Analytics Platform"
APP_ENV=development                      # development | staging | production
APP_VERSION=1.0.0
DEBUG=true                               # Set to false in production
LOG_LEVEL=INFO                           # DEBUG | INFO | WARNING | ERROR | CRITICAL
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS

# ------------------------------------------------------------------------------
# POSTGRESQL DATABASE
# ------------------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=covid19_analytics
POSTGRES_USER=covid_admin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_SCHEMA=public
DATABASE_URL=postgresql://covid_admin:CHANGE_ME_STRONG_PASSWORD@postgres:5432/covid19_analytics
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# FASTAPI BACKEND
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=4
BACKEND_RELOAD=false                     # Only true in development
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
API_V1_PREFIX=/api/v1
DOCS_URL=/docs
REDOC_URL=/redoc

# ------------------------------------------------------------------------------
# JWT AUTHENTICATION
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# REACT FRONTEND
# ------------------------------------------------------------------------------
VITE_APP_NAME="COVID-19 Analytics Portal"
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# ------------------------------------------------------------------------------
# POWER BI EMBEDDED
# ------------------------------------------------------------------------------
POWERBI_TENANT_ID=your-azure-tenant-id
POWERBI_CLIENT_ID=your-azure-app-client-id
POWERBI_CLIENT_SECRET=CHANGE_ME_POWERBI_SECRET
POWERBI_WORKSPACE_ID=your-powerbi-workspace-id
POWERBI_REPORT_ID=your-powerbi-report-id
VITE_POWERBI_EMBED_URL=https://app.powerbi.com/reportEmbed
VITE_POWERBI_CLIENT_ID=your-azure-app-client-id

# ------------------------------------------------------------------------------
# APACHE AIRFLOW
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__SQL_ALCHEMY_CONN=postgresql+psycopg2://airflow_user:CHANGE_ME_AIRFLOW_PASSWORD@postgres:5432/airflow_db
AIRFLOW__CORE__FERNET_KEY=CHANGE_ME_FERNET_KEY_GENERATE_WITH_PYTHON
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__WEBSERVER__SECRET_KEY=CHANGE_ME_AIRFLOW_WEBSERVER_SECRET
AIRFLOW__CELERY__BROKER_URL=redis://redis:6379/0
AIRFLOW__CELERY__RESULT_BACKEND=db+postgresql://airflow_user:CHANGE_ME_AIRFLOW_PASSWORD@postgres:5432/airflow_db
AIRFLOW__WEBSERVER__EXPOSE_CONFIG=false
AIRFLOW_ADMIN_USERNAME=airflow_admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN_PASSWORD
AIRFLOW_ADMIN_EMAIL=admin@yourcompany.com

# ------------------------------------------------------------------------------
# REDIS (Airflow Celery Broker)
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# ------------------------------------------------------------------------------
# ETL CONFIGURATION
# ------------------------------------------------------------------------------
OWID_DATASET_URL=https://covid.ourworldindata.org/data/owid-covid-data.csv
OWID_DATASET_CODEBOOK_URL=https://covid.ourworldindata.org/data/owid-covid-codebook.csv
ETL_DATA_DIR=/app/data
ETL_RAW_DIR=/app/data/raw
ETL_PROCESSED_DIR=/app/data/processed
ETL_ARCHIVE_DIR=/app/data/archive
ETL_LOGS_DIR=/app/logs/etl
ETL_BATCH_SIZE=5000
ETL_SCHEDULE_INTERVAL="0 6 * * *"       # Daily at 06:00 UTC

# ------------------------------------------------------------------------------
# PGADMIN (Database Management UI)
# ------------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@yourcompany.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
PGADMIN_PORT=5050

# ------------------------------------------------------------------------------
# NGINX
# ------------------------------------------------------------------------------
NGINX_PORT=80
NGINX_SSL_PORT=443

# ------------------------------------------------------------------------------
# MONITORING & ALERTS
# ------------------------------------------------------------------------------
ENABLE_METRICS=true
METRICS_PORT=9090
ALERT_EMAIL_ENABLED=false
SMTP_HOST=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USER=alerts@yourcompany.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
ALERT_FROM_EMAIL=noreply@yourcompany.com
ALERT_TO_EMAIL=dataengineering@yourcompany.com
